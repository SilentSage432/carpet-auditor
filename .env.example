NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: Store Operations APIs (bulk map, rotation engine). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Phone SMS OTP recovery (AuthWall) requires Supabase Auth → Providers → Phone enabled
# (Twilio/MessageBird credentials configured in the Supabase dashboard).

# --- Hub identity / signing (pilot & production) ---
# REQUIRED for Master Admin login and bootstrap. No default — unset means Master PIN
# auth is unavailable (fail closed). Use a unique non-default value (never 1234).
HUB_MASTER_PIN=replace-with-unique-master-pin
# Recommended: dedicated HMAC secret for hub gate cookie + QR pairing tokens.
# Fallback chain if unset: CRON_SECRET → SUPABASE_SERVICE_ROLE_KEY → anon key → hardcoded (dev only risk).
HUB_GATE_SECRET=replace-with-long-random-string
# Optional dedicated secret for POST /api/auth/bootstrap-admin (falls back to CRON_SECRET).
BOOTSTRAP_SECRET=
# Optional store number when bootstrapping Master Admin (else first store / roster).
HUB_BOOTSTRAP_STORE_NUMBER=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron — Authorization: Bearer <CRON_SECRET> on /api/cron/weekly-rotation
# Also used as HMAC/bootstrap fallback when HUB_GATE_SECRET / BOOTSTRAP_SECRET unset.
CRON_SECRET=generate-a-long-random-string

# Optional public app origin for invite SMS links (defaults to request Origin)
NEXT_PUBLIC_APP_URL=https://your-deptsync-host.example

# Optional Twilio SMS for supervisor invites (otherwise copyable sms: link)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Gemini (Snap Bay, Copilot, taxonomy). Server-only — never NEXT_PUBLIC_.
# If unset, AI routes use local heuristic fallbacks where implemented.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
