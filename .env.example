NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: Store Operations APIs (bulk map, rotation engine). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Phone SMS OTP recovery (AuthWall) requires Supabase Auth → Providers → Phone enabled
# (Twilio/MessageBird credentials configured in the Supabase dashboard).

# --- Hub identity / signing (ALIGN-SEC-001) ---
# REQUIRED for Master Admin login and bootstrap. No default — unset means Master PIN
# auth is unavailable (fail closed). Use a unique non-default value (never 1234).
HUB_MASTER_PIN=replace-with-unique-master-pin

# REQUIRED: dedicated HMAC secret for hub gate cookie, QR pairing, and auth-verify cookies.
# Fail closed when unset. Do NOT reuse anon key, service role, CRON_SECRET, or hardcoded strings.
HUB_GATE_SECRET=replace-with-long-random-string

# REQUIRED for HTTP Master Admin recovery: POST /api/auth/bootstrap-admin
# Fail closed when unset. Do NOT reuse CRON_SECRET.
# Local script recovery without this: node --env-file=.env.local scripts/bootstrap-admin.mjs
BOOTSTRAP_SECRET=replace-with-long-random-bootstrap-secret

# Optional store number when bootstrapping Master Admin (else first store / roster).
HUB_BOOTSTRAP_STORE_NUMBER=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron — Authorization: Bearer <CRON_SECRET> on /api/cron/*
# Not a substitute for HUB_GATE_SECRET or BOOTSTRAP_SECRET (ALIGN-SEC-001).
CRON_SECRET=generate-a-long-random-string

# Optional public app origin for invite SMS links (defaults to request Origin)
NEXT_PUBLIC_APP_URL=https://your-deptsync-host.example

# Optional Twilio SMS for supervisor invites (otherwise copyable sms: link)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Gemini (Snap Bay, Copilot, taxonomy). Server-only — never NEXT_PUBLIC_.
# If unset, AI routes use local heuristic fallbacks where implemented.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# APP-UPC-001A — Appliance physical scan identity (server-only HMAC-SHA-256).
# REQUIRED for appliance barcode resolve/teach. Fail closed when unset.
# Independently rotatable — do NOT reuse HUB_GATE_SECRET / CRON_SECRET / auth secrets.
# Never expose via NEXT_PUBLIC_* or client bundles.
APPLIANCE_SCAN_HMAC_SECRET=replace-with-long-random-server-only-string
